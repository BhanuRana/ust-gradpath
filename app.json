{
  "expo": {
    "name": "UST GradPath",
    "slug": "ust-gradpath",
    "version": "1.0.0",
    "scheme": "gradpath",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.bhanurana.gradpath",
      "supportsTablet": true
    },
    "android": {
      "package": "com.bhanurana.gradpath",
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", ["expo-splash-screen", { "backgroundColor": "#1F4F91" }]],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
